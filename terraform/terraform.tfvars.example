aws_region         = "us-east-1"
project_name       = "oficina-mecanica"
environment        = "prod-simulated"
kubernetes_version = "1.35"
# eks_cluster_role_name is injected via GitHub Actions Variables (TF_VAR_eks_cluster_role_name)
# eks_cluster_role_name = "LabEksClusterRole"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 2

# aws_base_state_bucket is injected via GitHub Actions Variables (TF_VAR_aws_base_state_bucket)
aws_base_state_key    = "infra/prod-simulated/infra-base/terraform.tfstate"
aws_base_state_region = "us-east-1"

enable_metrics_server        = true
metrics_server_chart_version = "" # optional chart version pin
